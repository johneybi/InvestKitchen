{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trademind.local/session-contracts/1.0",
  "title": "TradeMind immutable session event manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_type", "event_id", "idempotency_key", "producer_id", "producer_release", "stream_id", "sequence", "previous_event_hash", "event_hash", "occurred_at", "published_at", "effective_at", "applicable_session_date", "market_timezone", "market", "correlation_id", "causation_id", "payload_file", "payload_bytes", "payload_sha256", "required_features"],
  "properties": {
    "schema_version": {"const": "1.0"}, "event_type": {"enum": ["SessionBrief", "SessionBriefAmendment", "MaterialContext"]}, "event_id": {"type": "string", "minLength": 1}, "idempotency_key": {"type": "string", "minLength": 1}, "producer_id": {"type": "string", "minLength": 1}, "producer_release": {"type": "string", "minLength": 1},
    "stream_id": {"type": "string", "pattern": "^(authority|context):[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "sequence": {"type": "integer", "minimum": 1}, "previous_event_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "occurred_at": {"$ref": "#/$defs/utcTimestamp"}, "published_at": {"$ref": "#/$defs/utcTimestamp"}, "effective_at": {"$ref": "#/$defs/utcTimestamp"}, "applicable_session_date": {"type": "string", "format": "date"}, "market_timezone": {"const": "Asia/Seoul"}, "market": {"const": "KRX"}, "correlation_id": {"type": "string", "minLength": 1}, "causation_id": {"type": ["string", "null"]}, "payload_file": {"const": "payload.json"}, "payload_bytes": {"type": "integer", "minimum": 2}, "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "required_features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "SessionBrief"}}}, "then": {"properties": {"stream_id": {"pattern": "^authority:[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "required_features": {"contains": {"const": "session_brief.v1"}}}}},
    {"if": {"properties": {"event_type": {"const": "SessionBriefAmendment"}}}, "then": {"properties": {"stream_id": {"pattern": "^authority:[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "required_features": {"contains": {"const": "session_amendment.v1"}}}}},
    {"if": {"properties": {"event_type": {"const": "MaterialContext"}}}, "then": {"properties": {"stream_id": {"pattern": "^context:[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "required_features": {"contains": {"const": "material_context.v1"}}}}}
  ],
  "$defs": {
    "utcTimestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "date": {"type": "string", "format": "date"},
    "sourceEvidence": {"type": "object", "additionalProperties": false, "required": ["document_id", "source_locator"], "properties": {"document_id": {"type": "string", "minLength": 1}, "source_locator": {"type": "string", "minLength": 1}, "text_sha256": {"$ref": "#/$defs/sha256"}}},
    "sourceDocument": {
      "type": "object", "additionalProperties": false, "required": ["document_id", "source_sha256", "registration_intent", "applicable_session_date", "source_role", "intent_authority", "intent_evidence_ref"],
      "properties": {"document_id": {"type": "string", "minLength": 1}, "source_sha256": {"$ref": "#/$defs/sha256"}, "published_at": {"type": ["string", "null"]}, "document_type": {"type": ["string", "null"]}, "registration_intent": {"const": "SESSION_TRADING_INPUT"}, "applicable_session_date": {"$ref": "#/$defs/date"}, "source_role": {"enum": ["PRIMARY_CHECKPOINT", "PREOPEN_SUPPLEMENT", "INTRADAY_UPDATE"]}, "intent_authority": {"enum": ["USER_EXPLICIT", "TRUSTED_SOURCE_PROFILE"]}, "intent_evidence_ref": {"type": "string", "minLength": 1}, "source_profile_id": {"type": ["string", "null"]}, "source_profile_version": {"type": ["string", "null"]}},
      "allOf": [{"if": {"required": ["source_profile_id"], "properties": {"source_profile_id": {"type": "string"}}}, "then": {"required": ["source_profile_version"]}}, {"if": {"required": ["source_profile_version"], "properties": {"source_profile_version": {"type": "string"}}}, "then": {"required": ["source_profile_id"]}}, {"if": {"properties": {"intent_authority": {"const": "TRUSTED_SOURCE_PROFILE"}}}, "then": {"required": ["source_profile_id", "source_profile_version"]}}]
    },
    "priorityLegacy": {"type": "object", "additionalProperties": false, "required": ["label", "source_stated"], "properties": {"label": {"type": "string", "minLength": 1}, "source_stated": {"const": true}}},
    "priorityModern": {
      "type": "object", "additionalProperties": false, "required": ["scale_id", "scale_version", "label", "source_stated", "document_order", "section_order", "item_order", "profile_id", "profile_version"],
      "properties": {"scale_id": {"type": "string", "minLength": 1}, "scale_version": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "source_stated": {"type": "boolean"}, "document_order": {"type": "integer", "minimum": 0}, "section_order": {"type": "integer", "minimum": 0}, "item_order": {"type": "integer", "minimum": 0}, "profile_id": {"type": ["string", "null"]}, "profile_version": {"type": ["string", "null"]}},
      "allOf": [{"if": {"properties": {"profile_id": {"type": "string"}}}, "then": {"required": ["profile_version"]}}, {"if": {"properties": {"profile_version": {"type": "string"}}}, "then": {"required": ["profile_id"]}}, {"if": {"properties": {"scale_id": {"pattern": "^source_profile:"}}}, "then": {"properties": {"label": {"pattern": "^[★☆]{1,5}$"}, "source_stated": {"const": true}}, "required": ["profile_id", "profile_version"]}}]
    },
    "candidateRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "source_value", "mapping_status", "canonical_symbol", "mapping_provenance"],
      "properties": {"kind": {"enum": ["SYMBOL", "GROUP"]}, "source_value": {"type": "string", "minLength": 1}, "mapping_status": {"enum": ["RESOLVED", "UNRESOLVED", "CONFLICT"]}, "canonical_symbol": {"type": ["string", "null"], "pattern": "^[0-9]{6}$"}, "mapping_provenance": {"anyOf": [{"$ref": "#/$defs/sourceEvidence"}, {"type": "null"}]}, "cluster_id": {"type": ["string", "null"], "minLength": 1}, "cluster_version": {"type": ["string", "null"], "minLength": 1}},
      "allOf": [{"if": {"properties": {"mapping_status": {"const": "RESOLVED"}}}, "then": {"properties": {"canonical_symbol": {"type": "string", "pattern": "^[0-9]{6}$"}, "mapping_provenance": {"$ref": "#/$defs/sourceEvidence"}}, "required": ["canonical_symbol", "mapping_provenance"]}}, {"if": {"properties": {"mapping_status": {"const": "UNRESOLVED"}}}, "then": {"properties": {"canonical_symbol": {"type": "null"}, "mapping_provenance": {"type": "null"}}}}, {"if": {"properties": {"mapping_status": {"const": "CONFLICT"}}}, "then": {"properties": {"canonical_symbol": {"type": "null"}, "mapping_provenance": {"$ref": "#/$defs/sourceEvidence"}}, "required": ["mapping_provenance"]}}, {"if": {"required": ["cluster_id"], "properties": {"cluster_id": {"type": "string"}}}, "then": {"required": ["cluster_version"]}}, {"if": {"required": ["cluster_version"], "properties": {"cluster_version": {"type": "string"}}}, "then": {"required": ["cluster_id"]}}]
    },
    "ground": {"type": "object", "additionalProperties": false, "required": ["ground_id", "ground_version", "relation", "status", "source_evidence"], "properties": {"ground_id": {"type": "string", "minLength": 1}, "ground_version": {"type": "string", "minLength": 1}, "relation": {"enum": ["REQUIRED_ALL", "ANY_ONE", "SUPPORTING", "UNKNOWN"]}, "status": {"enum": ["ACTIVE", "AMBIGUOUS", "WITHDRAWN", "INVALIDATED"]}, "source_evidence": {"$ref": "#/$defs/sourceEvidence"}}},
    "condition": {"type": "object", "additionalProperties": false, "required": ["kind", "text", "source_locator", "executionability", "rule_ref"], "properties": {"kind": {"enum": ["CONFIRMATION", "WAIT", "NO_CHASE", "EXHAUSTION", "INVALIDATION"]}, "text": {"type": "string", "minLength": 1, "maxLength": 512}, "source_locator": {"type": "string", "minLength": 1}, "executionability": {"enum": ["NON_EXECUTABLE", "DETERMINISTIC_REFERENCE"]}, "rule_ref": {"type": ["string", "null"], "minLength": 1}}, "allOf": [{"if": {"properties": {"executionability": {"const": "NON_EXECUTABLE"}}}, "then": {"properties": {"rule_ref": {"type": "null"}}}}, {"if": {"properties": {"executionability": {"const": "DETERMINISTIC_REFERENCE"}}}, "then": {"properties": {"rule_ref": {"type": "string", "minLength": 1}}}}]},
    "sessionIdeaLegacy": {"type": "object", "additionalProperties": false, "required": ["idea_id", "candidate", "theme", "catalyst", "confirmation", "invalidation", "session_relevance", "provenance"], "properties": {"idea_id": {"type": "string", "minLength": 1}, "candidate": {"type": "string", "minLength": 1}, "theme": {"type": ["string", "null"]}, "scope_type": {"type": ["string", "null"]}, "catalyst": {"type": ["string", "null"]}, "source_priority": {"anyOf": [{"$ref": "#/$defs/priorityLegacy"}, {"type": "null"}]}, "confirmation": {"type": "array"}, "invalidation": {"type": "array"}, "session_relevance": {"$ref": "#/$defs/sessionRelevance"}, "document_order": {"type": "integer", "minimum": 0}, "provenance": {"type": "object", "required": ["document_id"], "properties": {"document_id": {"type": "string", "minLength": 1}}, "additionalProperties": true}}},
    "sessionIdeaModern": {"type": "object", "additionalProperties": false, "required": ["idea_id", "record_version", "candidate", "candidate_ref", "theme", "catalyst", "confirmation", "invalidation", "grounds", "conditions", "session_relevance", "provenance", "source_priority"], "properties": {"idea_id": {"type": "string", "minLength": 1}, "record_version": {"type": "integer", "minimum": 1}, "candidate": {"type": "string", "minLength": 1}, "candidate_ref": {"$ref": "#/$defs/candidateRef"}, "theme": {"type": ["string", "null"]}, "scope_type": {"type": ["string", "null"]}, "catalyst": {"type": ["string", "null"]}, "source_priority": {"$ref": "#/$defs/priorityModern"}, "confirmation": {"type": "array"}, "invalidation": {"type": "array"}, "grounds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ground"}}, "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}}, "session_relevance": {"$ref": "#/$defs/sessionRelevance"}, "document_order": {"type": "integer", "minimum": 0}, "provenance": {"type": "object", "required": ["document_id"], "properties": {"document_id": {"type": "string", "minLength": 1}}, "additionalProperties": true}}},
    "sessionIdea": {"$ref": "#/$defs/sessionIdeaModern"}, "sessionRelevance": {"enum": ["ACTIONABLE_TODAY", "CONTEXT_ONLY", "AMBIGUOUS"]},
    "contextFact": {"type": "object", "additionalProperties": false, "required": ["fact_id", "text", "provenance"], "properties": {"fact_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1, "maxLength": 512}, "provenance": {"$ref": "#/$defs/sourceEvidence"}}},
    "contextItem": {"type": "object", "additionalProperties": false, "required": ["context_id", "record_version", "horizon", "supporting_facts", "related_idea_ids", "candidate_authority"], "properties": {"context_id": {"type": "string", "minLength": 1}, "record_version": {"type": "integer", "minimum": 1}, "horizon": {"enum": ["INTRADAY", "SESSION", "SWING", "LONG_TERM", "UNKNOWN"]}, "supporting_facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contextFact"}}, "related_idea_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "candidate_authority": {"const": "NONE"}}},
    "extractionLegacy": {"type": "object", "additionalProperties": false, "required": ["source_order_preserved", "source_priority_lossless", "unresolved_symbols", "conflicts"], "properties": {"source_order_preserved": {"const": true}, "source_priority_lossless": {"const": true}, "unresolved_symbols": {"type": "array"}, "conflicts": {"type": "array"}}},
    "extractionModern": {"type": "object", "additionalProperties": false, "required": ["source_order_preserved", "source_priority_lossless", "unresolved_symbols", "conflicts", "status", "blocked_reasons"], "properties": {"source_order_preserved": {"const": true}, "source_priority_lossless": {"const": true}, "unresolved_symbols": {"type": "array"}, "conflicts": {"type": "array"}, "status": {"enum": ["COMPLETE", "NO_ACTIONABLE_SIGNAL", "BLOCKED"]}, "blocked_reasons": {"type": "array", "maxItems": 0}}},
    "sessionBriefPayload": {"type": "object", "additionalProperties": false, "required": ["contract", "contract_version", "applicable_session_date", "market_timezone", "session_disposition", "source_documents", "candidate_ideas", "context_materials", "extraction"], "properties": {"contract": {"const": "SessionBrief"}, "contract_version": {"const": "1.0"}, "applicable_session_date": {"$ref": "#/$defs/date"}, "market_timezone": {"const": "Asia/Seoul"}, "session_disposition": {"enum": ["TRADE_SESSION", "NO_TRADE_SESSION"]}, "source_documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceDocument"}}, "candidate_ideas": {"type": "array", "items": {"$ref": "#/$defs/sessionIdea"}}, "context_materials": {"type": "array", "items": {"$ref": "#/$defs/contextItem"}}, "extraction": {"$ref": "#/$defs/extractionModern"}}, "allOf": [{"if": {"properties": {"session_disposition": {"const": "NO_TRADE_SESSION"}}}, "then": {"not": {"properties": {"candidate_ideas": {"contains": {"properties": {"session_relevance": {"const": "ACTIONABLE_TODAY"}}}}}}}}, {"if": {"properties": {"session_disposition": {"const": "TRADE_SESSION"}}}, "then": {"properties": {"candidate_ideas": {"contains": {"properties": {"session_relevance": {"const": "ACTIONABLE_TODAY"}}}}}}}]},
    "amendmentResolutionSource": {"type": "object", "additionalProperties": false, "required": ["document_id", "source_locator", "source_hash"], "properties": {"document_id": {"type": "string", "minLength": 1}, "source_locator": {"type": "string", "minLength": 1}, "source_hash": {"$ref": "#/$defs/sha256"}}},
    "amendmentResolution": {"type": "object", "additionalProperties": false, "required": ["reason", "source"], "properties": {"reason": {"type": "string", "minLength": 1}, "source": {"$ref": "#/$defs/amendmentResolutionSource"}}},
    "amendmentOperation": {"type": "object", "additionalProperties": false, "required": ["operation", "record_id", "record", "expected_prior_record_version", "expected_prior_record_hash"], "properties": {"operation": {"enum": ["add", "replace", "withdraw_eligibility", "hard_invalidation", "restore_eligibility"]}, "record_id": {"type": "string", "minLength": 1}, "record": {"type": ["object", "null"]}, "expected_prior_record_version": {"type": ["integer", "null"], "minimum": 1}, "expected_prior_record_hash": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "resolution": {"$ref": "#/$defs/amendmentResolution"}}, "allOf": [{"if": {"properties": {"operation": {"const": "add"}}}, "then": {"properties": {"record": {"type": "object"}, "expected_prior_record_version": {"type": "null"}, "expected_prior_record_hash": {"type": "null"}}, "not": {"required": ["resolution"]}}}, {"if": {"properties": {"operation": {"enum": ["replace", "withdraw_eligibility", "hard_invalidation"]}}}, "then": {"properties": {"expected_prior_record_version": {"type": "integer", "minimum": 1}, "expected_prior_record_hash": {"$ref": "#/$defs/sha256"}}, "not": {"required": ["resolution"]}}}, {"if": {"properties": {"operation": {"const": "restore_eligibility"}}}, "then": {"required": ["resolution"], "properties": {"record": {"type": "null"}, "expected_prior_record_version": {"type": "integer", "minimum": 1}, "expected_prior_record_hash": {"$ref": "#/$defs/sha256"}}}}, {"if": {"properties": {"operation": {"const": "replace"}}}, "then": {"properties": {"record": {"type": "object"}}}}, {"if": {"properties": {"operation": {"enum": ["withdraw_eligibility", "hard_invalidation"]}}}, "then": {"properties": {"record": {"type": "null"}}}}]},
    "sessionAmendmentSource": {"type": "object", "additionalProperties": false, "required": ["document_id", "source_hash", "source_locator", "registration_intent", "applicable_session_date", "source_role", "intent_authority", "intent_evidence_ref"], "properties": {"document_id": {"type": "string", "minLength": 1}, "source_hash": {"$ref": "#/$defs/sha256"}, "source_locator": {"type": "string", "minLength": 1}, "registration_intent": {"const": "SESSION_TRADING_INPUT"}, "applicable_session_date": {"$ref": "#/$defs/date"}, "source_role": {"enum": ["PRIMARY_CHECKPOINT", "PREOPEN_SUPPLEMENT", "INTRADAY_UPDATE"]}, "intent_authority": {"enum": ["USER_EXPLICIT", "TRUSTED_SOURCE_PROFILE"]}, "intent_evidence_ref": {"type": "string", "minLength": 1}, "source_profile_id": {"type": ["string", "null"], "minLength": 1}, "source_profile_version": {"type": ["string", "null"], "minLength": 1}}, "allOf": [{"if": {"required": ["source_profile_id"]}, "then": {"required": ["source_profile_version"]}}, {"if": {"required": ["source_profile_version"]}, "then": {"required": ["source_profile_id"]}}, {"if": {"properties": {"intent_authority": {"const": "TRUSTED_SOURCE_PROFILE"}}}, "then": {"required": ["source_profile_id", "source_profile_version"]}}]},
    "sessionAmendmentPayload": {"type": "object", "additionalProperties": false, "required": ["contract", "contract_version", "applicable_session_date", "base_brief_id", "base_brief_hash", "previous_authority_event", "changed_record_ids", "reason", "source", "operations"], "properties": {"contract": {"const": "SessionBriefAmendment"}, "contract_version": {"const": "1.0"}, "applicable_session_date": {"$ref": "#/$defs/date"}, "base_brief_id": {"type": "string", "minLength": 1}, "base_brief_hash": {"$ref": "#/$defs/sha256"}, "previous_authority_event": {"type": "object", "additionalProperties": false, "required": ["event_id", "event_hash"], "properties": {"event_id": {"type": "string", "minLength": 1}, "event_hash": {"$ref": "#/$defs/sha256"}}}, "changed_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "reason": {"type": "string", "minLength": 1}, "source": {"$ref": "#/$defs/sessionAmendmentSource"}, "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/amendmentOperation"}}}},
    "materialContextPayload": {"type": "object", "additionalProperties": false, "required": ["contract", "contract_version", "applicable_session_date", "materials", "candidate_authority"], "properties": {"contract": {"const": "MaterialContext"}, "contract_version": {"const": "1.0"}, "applicable_session_date": {"$ref": "#/$defs/date"}, "materials": {"type": "array", "items": {"$ref": "#/$defs/contextItem"}}, "candidate_authority": {"const": "NONE"}}}
  },
  "x-payloadVariants": {"SessionBrief": {"$ref": "#/$defs/sessionBriefPayload"}, "SessionBriefAmendment": {"$ref": "#/$defs/sessionAmendmentPayload"}, "MaterialContext": {"$ref": "#/$defs/materialContextPayload"}}
}
