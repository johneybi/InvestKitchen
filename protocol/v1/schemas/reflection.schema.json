{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trademind.local/protocol/v1/reflection.schema.json",
  "title": "TradeMind Reflection Session v1",
  "type": "object",
  "required": ["protocol_version", "session_id", "mode", "method", "started_at", "steps", "record_draft"],
  "properties": {
    "protocol_version": {"const": "1.0-draft"},
    "session_id": {"$ref": "common.schema.json#/$defs/id"},
    "mode": {"enum": ["pre", "post"]},
    "method": {
      "type": "object",
      "required": ["method_id", "version", "framework", "context_dependencies"],
      "properties": {
        "method_id": {"$ref": "common.schema.json#/$defs/id"},
        "version": {"type": "string", "minLength": 1},
        "framework": {"type": "string", "minLength": 1},
        "context_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capability", "optional"],
            "properties": {
              "capability": {"type": "string", "minLength": 1},
              "optional": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "started_at": {"$ref": "common.schema.json#/$defs/timePoint"},
    "context_ref": {"type": ["string", "null"]},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "prompt", "captures"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "captures": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "record_draft": {
      "type": "object",
      "required": ["considered_action", "emotions", "assumptions", "bias_candidates", "counterevidence", "waiting_conditions", "user_conclusion"],
      "properties": {
        "considered_action": {"type": ["string", "null"]},
        "emotions": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "bias_candidates": {"type": "array", "items": {"type": "string"}},
        "counterevidence": {"type": "array", "items": {"type": "string"}},
        "waiting_conditions": {"type": "array", "items": {"type": "string"}},
        "user_conclusion": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
