{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trademind.local/protocol/v1/extension-manifest.schema.json",
  "title": "TradeMind Extension Manifest v1",
  "type": "object",
  "required": ["extension_id", "name", "publisher", "version", "package_digest", "protocol_compatibility", "trust_level", "extension_type", "provides", "requires", "permissions", "network", "secret_requirements", "storage", "background"],
  "properties": {
    "extension_id": {"$ref": "common.schema.json#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": ["string", "null"]},
    "protocol_compatibility": {"type": "string", "minLength": 1},
    "trust_level": {"enum": ["official", "verified", "community", "local"]},
    "extension_type": {"enum": ["provider", "analysis", "reflection", "automation", "notification", "paper", "collector", "system_adapter"]},
    "provides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "contract_version", "input_contract", "output_contract", "execution_mode"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "contract_version": {"type": "string", "minLength": 1},
          "input_contract": {"type": "string", "minLength": 1},
          "output_contract": {"type": "string", "minLength": 1},
          "execution_mode": {"enum": ["builtin", "sandbox_worker", "external_service"]}
        },
        "additionalProperties": false
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "compatible_contract_versions", "optional"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "compatible_contract_versions": {"type": "string", "minLength": 1},
          "optional": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "permissions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "network": {
      "type": "object",
      "required": ["mode", "allowed_endpoints"],
      "properties": {
        "mode": {"enum": ["none", "allowlist"]},
        "allowed_endpoints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "secret_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["secret_scope", "purpose"],
        "properties": {
          "secret_scope": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "storage": {
      "type": "object",
      "required": ["private_storage_namespace", "canonical_direct_access", "cross_extension_storage_access"],
      "properties": {
        "private_storage_namespace": {"type": ["string", "null"]},
        "canonical_direct_access": {"type": "boolean"},
        "cross_extension_storage_access": {"const": false}
      },
      "additionalProperties": false
    },
    "background": {
      "type": "object",
      "required": ["required", "trigger_types", "side_effects"],
      "properties": {
        "required": {"type": "boolean"},
        "trigger_types": {"type": "array", "items": {"type": "string"}},
        "minimum_interval_seconds": {"type": ["integer", "null"], "minimum": 1},
        "side_effects": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "authority_outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {"extension_type": {"not": {"const": "system_adapter"}}},
        "required": ["extension_type"]
      },
      "then": {
        "properties": {
          "storage": {
            "properties": {"canonical_direct_access": {"const": false}}
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
