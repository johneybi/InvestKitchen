# Copy to /volume1/docker/trademind/runtime-deploy.env and keep it outside Git.
COMPOSE_PROJECT_NAME=trademind-runtime
TRADEMIND_TUNNEL_ID=tunnel_REPLACE
TRADEMIND_RUNTIME_UID=1000
TRADEMIND_RUNTIME_GID=1000
TRADEMIND_CONTROL_PLANE_API_KEY_FILE=/volume1/docker/trademind/secrets/trademind-runtime-api-key
TRADEMIND_PERSONAL_DATA_ROOT=/volume1/docker/trademind/runtime-data/personal
TRADEMIND_STATE_ROOT=/volume1/docker/trademind/runtime-data/state
TRADEMIND_BACKUP_ROOT=/volume1/docker/trademind/runtime-data/backups
INVESTKITCHEN_PORTFOLIO_AUTHORITY=personal-data
INVESTKITCHEN_CONNECTOR_WRITES=disabled
INVESTKITCHEN_POLICY_WRITES=disabled
INVESTKITCHEN_OPINION_WRITES=disabled
INVESTKITCHEN_MARKET_PROVIDER=none
INVESTKITCHEN_TOSS_MARKET_SECRET_HOST_FILE=/volume1/docker/trademind/secrets/toss-market-readonly.json
INVESTKITCHEN_ACCOUNT_SYNC=disabled
INVESTKITCHEN_ACCOUNT_BINDING_HOST_FILE=/volume1/docker/trademind/secrets/account-bindings.json
INVESTKITCHEN_TOSS_ACCOUNT_SECRET_HOST_FILE=/volume1/docker/trademind/secrets/toss-account-readonly.json
INVESTKITCHEN_NHPLUG_ACCOUNT_SECRET_HOST_FILE=/volume1/docker/trademind/secrets/nhplug-account-readonly.json
INVESTKITCHEN_ACCOUNT_SYNC_MAX_AGE_SECONDS=300
# Production should point this at an immutable registry digest after publishing.
TRADEMIND_RUNTIME_IMAGE_REF=trademind-runtime:synology-REPLACE_COMMIT
